{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/packages/resize-observer-spec",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.shared-spec.ts",
    "src/**/testing/**/*.ts",
    "src/test-setup.ts",
    "src/test-setup.vitest.ts",
    "jest.config.ts",
    "vitest.config.ts"
  ]
}
