# Dependencies
node_modules/

# Foreign lockfiles — this workspace is Yarn-only
pnpm-lock.yaml
package-lock.json

# Yarn (Berry) — commit yarn.lock and .yarnrc.yml, ignore the rest
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build output
dist/
tmp/
out-tsc/
/e2e/test-output/

# Nx
.nx/cache
.nx/workspace-data

# Testing / coverage
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Env / secrets — never commit these
.env
.env.*
!.env.example
# A token-bearing .npmrc must only ever exist in CI via ${NPM_TOKEN}.
.npmrc
.npmrc.local

# Angular / build caches
.angular/
/.angular-cli.json
/.ng/
*.tsbuildinfo
