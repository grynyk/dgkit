# Dependencies
node_modules/
.pnpm-store/

# Foreign lockfiles — this workspace is pnpm-only
package-lock.json
yarn.lock

# Build output
dist/
tmp/
out-tsc/
/e2e/test-output/

# Nx
.nx/cache
.nx/workspace-data

# Testing / coverage
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Env / secrets — never commit these
.env
.env.*
!.env.example
# The workspace-level .npmrc is committed (it holds no secrets). A token-bearing
# .npmrc must only ever exist in CI via ${NPM_TOKEN}, never committed here.
.npmrc.local

# Angular / build caches
.angular/
/.angular-cli.json
/.ng/
*.tsbuildinfo
