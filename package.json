{
  "name": "@dgkit/source",
  "version": "0.0.0",
  "private": true,
  "description": "dgkit — a monorepo of small, reusable, SSR-safe Angular frontend packages published under the @dgkit scope.",
  "license": "MIT",
  "author": {
    "name": "Daniel Grynyk",
    "email": "danielgrynyk@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.31.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:vitest": "nx run-many -t test-vitest",
    "test:all": "nx run-many -t test test-vitest",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground": "nx serve playground",
    "new:package": "node tools/create-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:vitest && pnpm build"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@analogjs/vitest-angular": "^2.6.3",
    "@angular/build": "^21.0.0",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "~21.2.0",
    "nx": "23.1.0",
    "prettier": "^3.6.0",
    "rxjs": "~7.8.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "zone.js": "~0.16.2"
  }
}
