{
  "name": "@dgkit/source",
  "version": "0.0.0",
  "private": true,
  "description": "dgkit — a monorepo of small, reusable, SSR-safe Angular frontend packages published under the @dgkit scope.",
  "license": "MIT",
  "author": {
    "name": "Danylo Grynyk",
    "email": "danielgrynyk@gmail.com"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "yarn": ">=4"
  },
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground": "nx serve playground",
    "new:package": "node tools/create-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "yarn build && node tools/publish-dist.mjs",
    "verify": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular/build": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "ng-packagr": "~22.2.0",
    "nx": "23.1.1",
    "prettier": "^3.6.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zone.js": "~0.16.2"
  }
}
